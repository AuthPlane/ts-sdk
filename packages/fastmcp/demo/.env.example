# Authplane FastMCP Example — Environment Variables
# Copy this file to .env

# Authorization server URL
AUTHPLANE_ISSUER=http://localhost:9000

# This server's base URL (resource is derived as BASE_URL/mcp)
AUTHPLANE_BASE_URL=http://localhost:8080

# Client secret for introspection (registered with the authorization server)
# Set this from your local authserver provisioning.
AUTHPLANE_CLIENT_SECRET=
